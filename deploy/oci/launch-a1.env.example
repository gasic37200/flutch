# launch-a1.env 로 복사해서 채운다. launch-a1.env 는 커밋하지 않는다(.gitignore의 *.env 규칙).
COMPARTMENT_ID="ocid1.tenancy.oc1..xxxx"          # 루트 구획 = 테넌시 OCID
SUBNET_ID="ocid1.subnet.oc1.ap-chuncheon-1.xxxx"  # 기존 VCN의 공용 서브넷 (포트폴리오와 같은 VCN이면 Security List에 80/443 추가)
IMAGE_ID="ocid1.image.oc1.ap-chuncheon-1.xxxx"    # Canonical Ubuntu 24.04 aarch64
AVAILABILITY_DOMAIN="Bpmp:AP-CHUNCHEON-1-AD-1"
SSH_PUBLIC_KEY_FILE="$HOME/.ssh/flutch_oci.pub"
# 선택: DISPLAY_NAME OCPUS MEMORY_GB BOOT_VOLUME_GB MAX_ATTEMPTS SLEEP_SECONDS
